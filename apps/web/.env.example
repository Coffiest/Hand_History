# Postgres (Supabase in prod, local Postgres in dev)
DATABASE_URL="postgresql://postgres:localdev@localhost:5432/handhistory_dev"

# Supabase (browser)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Supabase service (server-side token verification)
SUPABASE_SERVICE_ROLE_KEY=""

# Recognition microservice base URL (Fly.io in prod, localhost in dev)
RECOGNITION_SERVICE_URL="http://localhost:8080"

# Set to "1" to allow an unauthenticated dev user when Supabase is unconfigured
# (local development / CI smoke tests only — never in production).
ALLOW_DEV_USER="1"
